{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CraftML Studio",
  "version": "0.3.3",
  "identifier": "com.craftml.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CraftML Studio",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/": "bin/"
    },
    "externalBin": []
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/anandkr47/CraftML-Studio/releases/latest/download/updates.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxRUQzRDdDQUE5NjdENjEKUldSaGZaYXFmRDN0MGZtZ0M3OWxGRmhqQ1RDWGtSRm5CNlhFaUNpODhSSGFOcWZLMHpJOXVjN2sK"
    }
  }
}
