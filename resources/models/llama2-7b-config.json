{
  "model_name": "meta-llama/Llama-2-7b-hf",
  "display_name": "Llama 2 7B",
  "description": "Meta's Llama 2 7B parameter model - great for fine-tuning on consumer GPUs",
  "recommended_config": {
    "lora": {
      "r": 16,
      "lora_alpha": 32,
      "lora_dropout": 0.05,
      "target_modules": ["q_proj", "v_proj", "k_proj", "o_proj"]
    },
    "training": {
      "num_epochs": 3,
      "batch_size": 4,
      "learning_rate": 2e-4,
      "use_4bit": true,
      "gradient_checkpointing": true
    }
  },
  "requirements": {
    "min_gpu_memory_gb": 8,
    "min_ram_gb": 16,
    "cuda_required": false
  },
  "tags": ["llama", "causal-lm", "chat", "instruct"]
}

