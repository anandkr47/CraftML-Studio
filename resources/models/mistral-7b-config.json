{
  "model_name": "mistralai/Mistral-7B-v0.1",
  "display_name": "Mistral 7B",
  "description": "Mistral AI's 7B parameter model - excellent performance and efficiency",
  "recommended_config": {
    "lora": {
      "r": 16,
      "lora_alpha": 32,
      "lora_dropout": 0.05,
      "target_modules": ["q_proj", "v_proj", "k_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]
    },
    "training": {
      "num_epochs": 3,
      "batch_size": 4,
      "learning_rate": 2e-4,
      "use_4bit": true,
      "gradient_checkpointing": true
    }
  },
  "requirements": {
    "min_gpu_memory_gb": 8,
    "min_ram_gb": 16,
    "cuda_required": false
  },
  "tags": ["mistral", "causal-lm", "chat"]
}

